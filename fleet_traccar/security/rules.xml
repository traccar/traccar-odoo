<odoo>
  <record id="server_company_rule" model="ir.rule">
    <field name="name">Traccar servers by company</field><field name="model_id" ref="model_traccar_server"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="device_company_rule" model="ir.rule">
    <field name="name">Traccar devices by company</field><field name="model_id" ref="model_traccar_device"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
